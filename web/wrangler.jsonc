// The site is static files from out/ (next build), served by Cloudflare at flaremeter.app.
// Deploy with scripts/deploy-site.sh. See docs/releasing.md → "Domain and website" for the one-time setup.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "flaremeter",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./out",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [{ "pattern": "flaremeter.app", "custom_domain": true }]
}
