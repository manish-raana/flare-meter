// The site is static files from out/ (next build), served by Cloudflare at flaremeter.app. A small Worker
// (worker/index.ts) runs first only for the DMGs, to count downloads and send them to GitHub Releases when out/ has
// no copy, and for /api/downloads, which reads the count.
// Deploy with scripts/deploy-site.sh. See docs/releasing.md → "Domain and website" for the one-time setup.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "flaremeter",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/FlareMeter.dmg", "/downloads/*", "/api/*"]
  },
  "durable_objects": { "bindings": [{ "name": "DOWNLOADS", "class_name": "DownloadCounter" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DownloadCounter"] }],
  "routes": [{ "pattern": "flaremeter.app", "custom_domain": true }]
}
